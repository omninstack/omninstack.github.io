<div id="site-nav">
  <nav>
    <div class="container nav-content">
      <a href="/" class="logo">Omni<span>N</span>Stack</a>
      <div class="nav-links" id="nav-links">
        {% for item in site.nav %}
          <a href="{{ item.href }}">{{ item.label }}</a>
        {% endfor %}
        <div class="theme-switch" aria-label="Theme switcher" role="group">
          <button type="button" class="theme-toggle is-light" data-theme="light" aria-label="Use light mode" aria-pressed="true">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <span>Light</span>
          </button>
          <button type="button" class="theme-toggle is-dark" data-theme="dark" aria-label="Use dark mode" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <span>Dark</span>
          </button>
        </div>
        <a href="mailto:info@omninstack.com" class="btn btn-outline" style="padding: 0.7rem 1.8rem; font-size: 0.75rem; border-radius: 12px;">Contact Us</a>
      </div>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</div>
