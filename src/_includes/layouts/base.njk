<!DOCTYPE html>
<html lang="{{ lang or site.defaultLocale }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ metaTitle or title or site.seo.defaultTitle }}</title>
    <meta name="description" content="{{ metaDescription or description or site.seo.defaultDescription }}">
    <meta property="og:title" content="{{ metaTitle or title or site.seo.defaultTitle }}">
    <meta property="og:description" content="{{ metaDescription or description or site.seo.defaultDescription }}">
    <meta property="og:type" content="{{ ogType or site.seo.ogType }}">
    <meta property="og:image" content="{{ ogImage or site.seo.ogImage }}">
    <link rel="canonical" href="{{ site.url }}{{ permalink or '/' }}">
    <link rel="stylesheet" href="/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/assets/favicon.png">
  </head>
  <body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    {% include "partials/nav.njk" %}

    <main>
      {% block content %}{% endblock %}
    </main>

    {% include "partials/footer.njk" %}

    <script src="/script.js"></script>
    <script src="/nav-footer.js"></script>
  </body>
</html>
