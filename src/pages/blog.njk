---
permalink: blog.html
title: Blog
eyebrow: Insights & updates
intro: Field notes on edge AI, industrial IoT, and the practical realities of deploying AI systems that sense, reason, and act.
---
{% extends "layouts/base.njk" %}

{% block content %}
<section class="section-block reveal">
  <div class="container">
    <div class="page-header reveal">
      <h4 class="accent-text mono">{{ eyebrow }}</h4>
      <h1>{{ title }}</h1>
      <p style="font-size: 1.2rem; color: var(--silver); max-width: 800px; margin: 1rem auto 0; line-height: 1.7;">{{ intro }}</p>
    </div>
  </div>
</section>

<section class="section-block">
  <div class="container">
    <div class="features-grid post-list">
      {% for post in collections.posts | reverse %}
        <a class="glass-card post-card" href="{{ post.url }}">
          <p class="post-meta mono">{{ post.date | dateIso }}</p>
          <h3>{{ post.data.title }}</h3>
          <p style="color: var(--text-secondary);">{{ post.data.excerpt }}</p>
          <span class="post-read mono">Read post &rarr;</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
