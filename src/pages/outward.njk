---
layout: base.njk
permalink: marketing/outward.html
title: Outward Platform Overview
description: Outward is an omnichannel AI engagement platform that connects digital marketing to measurable offline retail sales.
---

{% set product = outward %}

<header class="page-header reveal">
  <h4 class="accent-text mono">{{ product.tagline }}</h4>
  <h1>{{ product.name }} Platform <span class="gradient-text">Overview</span></h1>
  <p style="font-size: 1.35rem; color: var(--silver); margin-top: 1rem; max-width: 800px; margin-left: auto; margin-right: auto; line-height: 1.6;">
    {{ product.heroLead }}
  </p>
</header>

<section class="section-block reveal" id="overview-sec">
  <div class="container">
    <div class="glass-box" style="border-color: var(--cyan); background: linear-gradient(135deg, rgba(0, 31, 63, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%); padding: 3.5rem;">
      <h4 style="font-size: 1.6rem; color: #fff; margin-bottom: 1.5rem; line-height: 1.4;">{{ product.heroTitle }}</h4>
      <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem;">
        {{ product.summary }}
      </p>
      <div class="btn-group">
        <a href="mailto:info@omninstack.com" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 0.8rem; border-radius: 12px;">Book a Live Demo</a>
        <a href="#capabilities" class="btn btn-outline" style="padding: 1rem 2.5rem; font-size: 0.8rem; border-radius: 12px;">Explore Capabilities</a>
      </div>
    </div>
  </div>
</section>

<section class="section-block reveal">
  <div class="container">
    <h3>Key Value Propositions</h3>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      {% for item in product.highlights %}
        <div class="glass-box">
          <h4>{{ loop.index }}. {{ item.title }}</h4>
          <p>{{ item.copy }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="capabilities" class="section-block reveal">
  <div class="container">
    <h3>Capability Matrix</h3>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Product Capability</th>
            <th>Business Impact</th>
          </tr>
        </thead>
        <tbody>
          {% for capability in product.capabilities %}
          <tr>
            <td style="color: #fff; font-weight: 700;">{{ capability }}</td>
            <td>Enables measurable engagement, reduced churn, and stronger conversion outcomes.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
